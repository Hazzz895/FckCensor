{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/jsx-runtime": ["./src/ui/dom-factory.ts"],
    },
    "jsxImportSource": "@" 
  },
  "include": ["src", "modules/**/*.ts", "vite.config.ts", "addon.config.d.mts", "env.d.ts"]
}
